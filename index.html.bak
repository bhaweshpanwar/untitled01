            <!-- =============================================================== -->
            <!-- HERO EMBLEM SLOT: SWAP IN /assets/emblem.png HERE               -->
            <!-- To use your custom transparent PNG emblem:                      -->
            <!-- 1. Drop 'emblem.png' inside the 'assets/' folder.               -->
            <!-- 2. The script checks for it automatically and swaps it in!      -->
            <!-- Or uncomment the manual <image> tag below and remove the SVG:   -->
            <!--                                                                 -->
            <!-- <image id="custom-emblem-image" href="assets/emblem.png"        -->
            <!--        x="525" y="275" width="150" height="150"                 -->
            <!--        preserveAspectRatio="xMidYMid meet" />                  -->
            <!-- =============================================================== -->

            <!-- High-Quality Inline SVG Placeholder Emblem -->
            <g id="placeholder-emblem-svg" transform="translate(600, 350)">
              <!-- Asteroid Base Body (Realistic shaded asteroid rock) -->
              <path 
                d="M -54 18 C -58 4, -50 -14, -36 -28 C -22 -40, -2 -42, 18 -38 C 38 -34, 56 -18, 58 4 C 60 26, 42 44, 20 48 C -4 52, -32 46, -48 34 Z" 
                fill="#334155" 
                stroke="#475569" 
                stroke-width="2"
              />
              <!-- Asteroid Rock Facets & Contours -->
              <path d="M -36 -28 C -14 -32, 10 -28, 28 -18 C 12 -8, -12 -12, -36 -28 Z" fill="#475569" opacity="0.6" />
              <path d="M -48 34 C -22 30, 8 36, 20 48 C -6 52, -30 46, -48 34 Z" fill="#1E293B" opacity="0.8" />
              
              <!-- Craters -->
              <!-- Main Crater -->
              <ellipse cx="-18" cy="8" rx="14" ry="8" fill="#1E293B" stroke="#64748B" stroke-width="1.2" transform="rotate(-8 -18 8)" />
              <ellipse cx="-19" cy="9" rx="10" ry="5.5" fill="#0F172A" transform="rotate(-8 -18 8)" />
              <!-- Crater 2 -->
              <ellipse cx="24" cy="14" rx="11" ry="6.5" fill="#1E293B" stroke="#64748B" stroke-width="1" transform="rotate(12 24 14)" />
              <ellipse cx="23" cy="15" rx="8" ry="4.5" fill="#0F172A" transform="rotate(12 24 14)" />
              <!-- Crater 3 -->
              <ellipse cx="4" cy="-18" rx="8" ry="4.5" fill="#1E293B" stroke="#64748B" stroke-width="1" />
              <!-- Micro Craters -->
              <circle cx="-38" cy="14" r="3" fill="#1E293B" />
              <circle cx="34" cy="-8" r="2.5" fill="#1E293B" />

              <!-- Astronaut Silhouette Seated on Top Ridge -->
              <g id="astronaut-silhouette" transform="translate(0, -38)">
                <!-- Life-Support Backpack -->
                <rect x="-16" y="-12" width="7" height="15" rx="2.5" fill="#0B1220" />
                <!-- Torso Suit -->
                <path d="M -10 -12 C -6 -14, 2 -14, 6 -12 L 8 4 L -10 4 Z" fill="#0B1220" />
                <!-- Helmet Dome -->
                <circle cx="-1" cy="-20" r="9" fill="#0B1220" />
                <!-- Gold Visor Reflection -->
                <ellipse cx="2" cy="-20" rx="5" ry="4" fill="#F97316" />
                <ellipse cx="3" cy="-21" rx="2.5" ry="1.5" fill="#FED7AA" />
                <!-- Seated Legs / Boots on Rock -->
                <path d="M -10 4 C -12 10, -6 16, 2 16 L 8 16 C 12 16, 12 10, 8 4 Z" fill="#0B1220" />
                <!-- Right Hand Pointing Towards Orbit -->
                <path d="M 4 -8 C 12 -12, 16 -16, 20 -22" fill="none" stroke="#0B1220" stroke-width="2.5" stroke-linecap="round" />
                <circle cx="21" cy="-23" r="1.5" fill="#2563EB" />
              </g>
            </g>
          </g>

          <!-- ================================================================= -->
          <!-- COMET EXIT TAIL (Thread flowing out bottom into next section)      -->
          <!-- ================================================================= -->
          <g id="comet-tail-exit-stream">
            <path 
              d="M 600 640 C 600 675, 595 710, 600 750" 
              fill="none" 
              stroke="url(#cometTailGrad)" 
              stroke-width="2.5" 
              stroke-linecap="round" 
              opacity="0.85"
            />
          </g>

        </svg>
      </div>
    </section>

    <!-- ======================================================================= -->
    <!-- SECTION 2: SHOWREEL VIDEO (Pure video div, zero text, zoomed fullscreen) -->
    <!-- Top 10% peeks through the bottom of the initial hero viewport           -->
    <!-- ======================================================================= -->
    <section id="showreel" class="relative pt-0 pb-20 md:pb-32 bg-white overflow-hidden border-b border-slate-100 flex flex-col items-center">
      
      <!-- Faint ambient glow behind video player -->
      <div class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-gradient-to-tr from-blue-500/10 via-orange-500/10 to-purple-500/10 blur-3xl rounded-full" aria-hidden="true"></div>

      <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20">
        
        <!-- Video Card: Pure div playing video silently without music, zoomed-in animation on hover & click -->
        <div 
          id="showreel-card"
          class="video-zoom-card group relative w-full aspect-video rounded-2xl sm:rounded-3xl overflow-hidden bg-slate-950 border border-slate-200/90 shadow-2xl shadow-slate-900/15 cursor-pointer select-none"
          aria-label="Click to open video full screen"
          title="Click to expand full screen"
        >
          <!-- HTML5 Video: Pure silent loop without controls or audio -->
          <video 
            id="showreel-video"
            src="assets/short.mp4" 
            autoplay 
            loop 
            muted 
            playsinline 
            preload="auto"
            class="w-full h-full object-cover select-none pointer-events-none"
          ></video>

          <!-- Subtle Expand Hint Pill on Hover -->
          <div class="pointer-events-none absolute bottom-4 right-4 sm:bottom-6 sm:right-6 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-950/70 backdrop-blur-md border border-white/20 text-white text-xs font-semibold shadow-xl">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
              <span>Full Screen</span>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- FULLSCREEN ZOOMED VIDEO MODAL OVERLAY -->
    <div 
      id="video-fullscreen-modal"
      class="fixed inset-0 z-50 bg-black/95 backdrop-blur-2xl opacity-0 pointer-events-none transition-all duration-300 ease-out flex items-center justify-center p-3 sm:p-6"
      aria-hidden="true"
    >
      <!-- Close Button -->
      <button 
        id="close-fullscreen-modal-btn"
        type="button" 
        class="absolute top-4 right-4 sm:top-6 sm:right-6 z-50 flex items-center gap-2 px-3.5 py-2 rounded-full bg-white/10 hover:bg-white/25 border border-white/20 text-white text-xs font-semibold backdrop-blur-md shadow-xl transition-all hover:scale-105 focus-visible:ring-2 focus-visible:ring-brand-blue"
        aria-label="Close Full Screen"
      >
        <span>✕ Close</span>
        <kbd class="hidden sm:inline-block text-[10px] bg-white/20 px-1.5 py-0.5 rounded font-mono">Esc</kbd>
      </button>

      <!-- Zoomed In Modal Video Container -->
      <div class="modal-video-box w-full max-w-7xl max-h-[92vh] aspect-video rounded-2xl overflow-hidden shadow-2xl border border-white/10 relative transition-transform duration-400 ease-out">
        <video 
          id="modal-fullscreen-video"
          src="assets/short.mp4" 
          autoplay 
          loop 
          muted 
          playsinline 
          class="w-full h-full object-contain bg-black"
        ></video>
      </div>
    </div>

    <!-- ======================================================================= -->
    <!-- PART 3 — PAGE SCAFFOLD WITH CONNECTING SCROLL-THREAD                    -->
    <!-- Semantic placeholder sections with the scroll-thread running down      -->
    <!-- ======================================================================= -->
    <div class="relative w-full">
      
      <!-- Continuous Scroll-Thread SVG (Draws dynamically on scroll) -->
      <div class="absolute inset-0 pointer-events-none z-10 flex justify-center overflow-hidden" aria-hidden="true">
        <svg class="w-24 h-full" viewBox="0 0 96 2400" preserveAspectRatio="none" fill="none">
          <defs>
            <linearGradient id="threadGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#2563EB" />
              <stop offset="35%" stop-color="#F97316" />
              <stop offset="70%" stop-color="#7C3AED" />
              <stop offset="100%" stop-color="#0D9488" />
            </linearGradient>
          </defs>
          <!-- Background faint guide line -->
          <path 
            d="M 48 0 C 48 300, 30 600, 48 900 C 66 1200, 32 1500, 48 1800 C 64 2100, 48 2300, 48 2400" 
            stroke="#E2E8F0" 
            stroke-width="1.5" 
            stroke-dasharray="4 4"
          />
          <!-- Active Drawing Glowing Line -->
          <path 
            id="scroll-thread-path"
            d="M 48 0 C 48 300, 30 600, 48 900 C 66 1200, 32 1500, 48 1800 C 64 2100, 48 2300, 48 2400" 
            stroke="url(#threadGrad)" 
            stroke-width="2.5" 
            stroke-linecap="round"
            style="filter: drop-shadow(0 0 5px rgba(37,99,235,0.4));"
          />
        </svg>
      </div>

      <!-- #story (scroll-storytelling area) -->
      <section id="story" class="relative py-28 min-h-[460px] border-b border-slate-100 flex items-center justify-center bg-surface-alt">
        <!-- #story: scroll-storytelling area -->
        <div class="text-center px-4">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-xs font-semibold tracking-wider uppercase font-mono">
            #story
          </span>
          <p class="text-sm text-slate-400 mt-2">Scroll-storytelling area</p>
        </div>
      </section>

      <!-- #services (core services breakdown area) -->
      <section id="services" class="relative py-28 min-h-[460px] border-b border-slate-100 flex items-center justify-center bg-white">
        <!-- #services: comprehensive service breakdown -->
        <div class="text-center px-4">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-xs font-semibold tracking-wider uppercase font-mono">
            #services
          </span>
          <p class="text-sm text-slate-400 mt-2">Comprehensive service breakdown</p>
        </div>
      </section>

      <!-- #contact (contact & inquiry area) -->
      <section id="contact" class="relative py-28 min-h-[460px] border-b border-slate-100 flex items-center justify-center bg-surface-alt">
        <!-- #contact: contact & inquiry area -->
        <div class="text-center px-4">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-xs font-semibold tracking-wider uppercase font-mono">
            #contact
          </span>
          <p class="text-sm text-slate-400 mt-2">Contact &amp; inquiry area</p>
        </div>
      </section>

      <!-- Minimal footer placeholder -->
      <footer class="relative py-12 border-t border-slate-200 bg-white text-center text-sm text-slate-500">
        <!-- Minimal footer placeholder -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-xs text-slate-400">
            &copy; E-Comet. One Digital Growth Partner for Your Entire Business.
          </p>
          <div class="flex items-center gap-6 text-xs text-slate-400">
            <span>Indore, Madhya Pradesh, India</span>
            <span>·</span>
            <a href="/contact/" class="hover:text-ink transition-colors">Contact</a>
          </div>
        </div>
      </footer>

    </div>
