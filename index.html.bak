<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>E-Comet | Digital Marketing, Marketplace Management &amp; Website Development Agency</title>
  <meta name="description" content="E-Comet is your full-funnel digital growth partner. We scale businesses across search visibility, performance ads, e-commerce marketplaces, and custom web platforms.">
  <link rel="canonical" href="https://ecomet.agency/">
  <meta name="theme-color" content="#FFFFFF">

  <!-- Open Graph / Social Meta -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://ecomet.agency/">
  <meta property="og:title" content="E-Comet | Digital Marketing, Marketplace Management &amp; Website Development Agency">
  <meta property="og:description" content="One Digital Growth Partner for Your Entire Business. Scaling search, paid ads, marketplaces, and web platforms.">
  <meta property="og:image" content="assets/logo.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="E-Comet | Digital Marketing, Marketplace Management &amp; Website Development Agency">
  <meta name="twitter:description" content="One Digital Growth Partner for Your Entire Business. Scaling search, paid ads, marketplaces, and web platforms.">
  <meta name="twitter:image" content="assets/logo.jpg">

  <!-- Favicon (Inline SVG Data URI) -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%230B1220'/%3E%3Cellipse cx='16' cy='16' rx='13' ry='6' fill='none' stroke='%232563EB' stroke-width='2' transform='rotate(-25 16 16)'/%3E%3Ccircle cx='23' cy='11' r='3.5' fill='%23F97316'/%3E%3C/svg%3E">

  <!-- Typography: Plus Jakarta Sans via Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            ink: '#0B1220',
            muted: '#475569',
            surface: '#FFFFFF',
            'surface-alt': '#F8FAFC',
            'border-subtle': '#E2E8F0',
            brand: {
              blue: '#2563EB',
              orange: '#F97316'
            },
            pillar: {
              marketing: '#2563EB',
              marketplaces: '#F97316',
              websites: '#7C3AED',
              creative: '#0D9488'
            }
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'Inter', 'system-ui', '-apple-system', 'sans-serif']
          }
        }
      }
    }
  </script>

  <!-- Organization JSON-LD (Name, URL, Logo only — strictly no fake reviews/ratings) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "E-Comet",
    "url": "https://ecomet.agency/",
    "logo": "https://ecomet.agency/assets/logo.jpg"
  }
  </script>

  <style>
    :root {
      --color-base: #FFFFFF;
      --color-alt: #F8FAFC;
      --color-ink: #0B1220;
      --color-muted: #475569;
      --color-border: #E2E8F0;
      --color-brand-blue: #2563EB;
      --color-brand-orange: #F97316;
      --pillar-marketing: #2563EB;
      --pillar-marketplaces: #F97316;
      --pillar-websites: #7C3AED;
      --pillar-creative: #0D9488;
    }

    /* Subtle background dotted canvas */
    .bg-dotted-grid {
      background-image: radial-gradient(#CBD5E1 1.25px, transparent 1.25px);
      background-size: 28px 28px;
    }

    /* Header Focus Overlay & Active State */
    #header-backdrop-blur {
      transition: opacity 280ms cubic-bezier(0.16, 1, 0.3, 1), backdrop-filter 280ms cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, backdrop-filter;
    }

    .header-focused {
      background-color: rgba(255, 255, 255, 0.98) !important;
      box-shadow: 0 12px 36px -4px rgba(11, 18, 32, 0.08), 0 0 0 1px rgba(226, 232, 240, 0.9) !important;
    }

    /* Gentle floating animation for hero emblem */
    @keyframes floatEmblem {
      0%, 100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-6px);
      }
    }

    .emblem-float {
      animation: floatEmblem 6s ease-in-out infinite;
      transform-origin: center center;
    }

    /* Orbit pillar activation transitions */
    .pillar-ring {
      transition: stroke-width 0.35s ease, opacity 0.35s ease, filter 0.35s ease;
    }

    .pillar-group {
      transition: opacity 0.35s ease;
    }

    .pillar-group.is-dimmed {
      opacity: 0.45;
    }

    .pillar-group.is-active {
      opacity: 1 !important;
    }

    .pillar-group.is-active .pillar-ring {
      stroke-width: 2.5px;
      opacity: 1 !important;
      filter: drop-shadow(0 0 8px currentColor);
    }

    .pillar-group.is-active .pillar-label-badge {
      transform: scale(1.07);
      filter: drop-shadow(0 4px 14px rgba(11, 18, 32, 0.12));
    }

    .pillar-group.is-active .service-chip {
      filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.12));
    }

    .pillar-group.is-active .comet-entity {
      opacity: 1;
    }

    .comet-entity {
      opacity: 0;
      transition: opacity 0.4s ease;
    }

    .pillar-label-badge {
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), filter 0.25s ease;
      cursor: pointer;
    }

    .pillar-label-badge:hover {
      transform: scale(1.09);
    }

    /* Service chip styling & hover lifts */
    .service-chip {
      cursor: pointer;
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), filter 0.2s ease;
    }

    .service-chip:hover {
      filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.18)) !important;
    }

    .service-chip:hover rect {
      stroke-width: 1.75px;
    }

    /* Mega menu panel animation */
    .megamenu-panel {
      transition: opacity 150ms cubic-bezier(0.16, 1, 0.3, 1), transform 150ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Accessible focus-visible ring */
    a:focus-visible, button:focus-visible {
      outline: 2px solid #2563EB;
      outline-offset: 2px;
    }

    /* Video Zoom Card & Fullscreen Modal */
    .video-zoom-card {
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s ease;
      will-change: transform;
    }

    .video-zoom-card:hover {
      transform: scale(1.025);
      box-shadow: 0 30px 70px -15px rgba(11, 18, 32, 0.22);
    }

    #video-fullscreen-modal.is-active {
      opacity: 1 !important;
      pointer-events: auto !important;
    }

    #video-fullscreen-modal.is-active .modal-video-box {
      transform: scale(1) !important;
    }

    #video-fullscreen-modal .modal-video-box {
      transform: scale(0.88);
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Reduced motion accessibility */
    @media (prefers-reduced-motion: reduce) {
      .emblem-float {
        animation: none !important;
      }
      .comet-entity {
        opacity: 0.6 !important;
      }
      .pillar-group {
        opacity: 0.85 !important;
      }
      .pillar-ring {
        opacity: 0.85 !important;
      }
      #header-backdrop-blur {
        backdrop-filter: none !important;
      }
      .video-zoom-card:hover {
        transform: none !important;
      }
    }
  </style>
</head>
<body class="bg-surface text-ink font-sans antialiased selection:bg-blue-100 selection:text-blue-900 overflow-x-hidden min-h-screen flex flex-col pb-24 md:pb-0">

  <!-- Accessible Skip to Content Link -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-blue-600 focus:text-white focus:font-semibold focus:text-sm focus:rounded-lg focus:shadow-xl focus:ring-2 focus:ring-offset-2 focus:ring-blue-600">
    Skip to content
  </a>

  <!-- ========================================================================= -->
  <!-- SCREEN BACKDROP BLUR OVERLAY (Fades in on header/nav hover, focuses header)-->
  <!-- ========================================================================= -->
  <div 
    id="header-backdrop-blur" 
    class="fixed inset-0 z-40 bg-slate-900/30 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300 ease-out" 
    aria-hidden="true"
  ></div>

  <!-- ========================================================================= -->
  <!-- PART 1 — HEADER (Sticky, 72px high, ONE LINE ONLY on desktop >=1024px)    -->
  <!-- ========================================================================= -->
  <header id="main-header" class="sticky top-0 z-50 h-[72px] bg-white transition-all duration-300">
    <div class="max-w-[1440px] h-full mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between flex-nowrap gap-2 xl:gap-4">
      
      <!-- Brand Logo Wordmark (mix-blend-mode: multiply so white box disappears) -->
      <a href="/" class="flex items-center flex-shrink-0 group" aria-label="E-Comet Homepage">
        <img 
          src="assets/logo.jpg" 
          alt="E-Comet" 
          class="h-9 sm:h-10 w-auto object-contain mix-blend-multiply select-none group-hover:opacity-90 transition-opacity"
          onerror="this.onerror=null; this.classList.add('hidden'); document.getElementById('logo-text-fallback').classList.remove('hidden');"
        />
        <!-- Crisp Fallback if image asset is loading or missing -->
        <span id="logo-text-fallback" class="hidden text-xl font-extrabold tracking-tight text-ink flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-blue inline-block"></span>
          <span>E<span class="text-brand-blue">-</span>COMET</span>
        </span>
      </a>

      <!-- Desktop Centre Nav (One Line Only >=1024px, driven by JS MENU_DATA) -->
      <nav id="desktop-nav" class="hidden lg:flex items-center flex-nowrap gap-1 xl:gap-2 whitespace-nowrap text-[13.5px] xl:text-[14px] font-semibold text-ink" aria-label="Main Navigation">
        <!-- Dynamically populated trigger buttons -->
      </nav>

      <!-- Desktop Right Actions -->
      <div class="hidden lg:flex items-center flex-nowrap flex-shrink-0 gap-2.5 xl:gap-3">
        <!-- WhatsApp Round Icon Button -->
        <a 
          href="https://wa.me/91XXXXXXXXXX" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-10 h-10 rounded-full border border-slate-200 bg-white hover:bg-emerald-50 hover:border-emerald-400 text-emerald-600 flex items-center justify-center transition-all duration-200 hover:scale-105 shadow-sm focus-visible:ring-2 focus-visible:ring-emerald-500" 
          aria-label="Chat on WhatsApp"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
        </a>

        <!-- Primary CTA Button (Electric Blue with subtle gradient + arrow nudge) -->
        <a 
          href="/growth-audit/" 
          class="group inline-flex items-center justify-center gap-1.5 px-4 xl:px-5 py-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-500 hover:to-blue-600 text-white font-semibold text-xs xl:text-sm shadow-sm hover:shadow-md hover:shadow-blue-500/25 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
        >
          <span>Free Growth Audit</span>
          <span class="inline-block transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Mobile/Tablet Hamburger Trigger (<1024px) -->
      <button 
        id="mobile-menu-trigger" 
        type="button" 
        class="lg:hidden w-11 h-11 flex items-center justify-center rounded-xl border border-slate-200 text-ink hover:bg-slate-50 focus-visible:ring-2 focus-visible:ring-brand-blue" 
        aria-label="Toggle navigation menu" 
        aria-expanded="false" 
        aria-controls="mobile-menu-drawer"
      >
        <svg id="hamburger-icon" class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg id="close-icon" class="w-6 h-6 stroke-current hidden" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

    </div>

    <!-- Desktop Mega Menu Dropdown Container (SOLID WHITE panels, 12px below header) -->
    <div id="megamenu-container" class="hidden lg:block absolute left-0 right-0 top-full pointer-events-none z-50">
      <!-- Mega panels dynamically injected here -->
    </div>
  </header>

  <!-- ========================================================================= -->
  <!-- MOBILE SLIDE-IN ACCORDION PANEL (<1024px)                                 -->
  <!-- ========================================================================= -->
  <div 
    id="mobile-menu-drawer" 
    class="fixed inset-0 z-50 bg-white flex flex-col transition-transform duration-300 translate-x-full lg:hidden" 
    aria-hidden="true"
  >
    <!-- Drawer Header Bar -->
    <div class="h-[72px] px-4 sm:px-6 border-b border-slate-100 flex items-center justify-between">
      <a href="/" class="flex items-center" aria-label="E-Comet Homepage">
        <img src="assets/logo.jpg" alt="E-Comet" class="h-8 w-auto object-contain mix-blend-multiply" />
      </a>
      <button 
        id="mobile-drawer-close" 
        type="button" 
        class="w-11 h-11 flex items-center justify-center rounded-xl border border-slate-200 text-ink hover:bg-slate-50" 
        aria-label="Close navigation menu"
      >
        <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Scrollable Accordion Body (One open at a time, 48px min tap targets) -->
    <div id="mobile-accordion-list" class="flex-1 overflow-y-auto px-4 sm:px-6 py-4 divide-y divide-slate-100">
      <!-- Populated via MENU_DATA -->
    </div>

    <!-- Drawer Sticky Bottom Actions -->
    <div class="p-4 sm:p-6 border-t border-slate-200 bg-slate-50 flex items-center gap-3">
      <a 
        href="/growth-audit/" 
        class="flex-1 py-3 px-4 rounded-xl bg-brand-blue text-white font-semibold text-center text-sm shadow-sm hover:bg-blue-700 transition-colors"
      >
        Free Growth Audit →
      </a>
      <a 
        href="https://wa.me/91XXXXXXXXXX" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-12 h-12 rounded-xl border border-slate-200 bg-white text-emerald-600 flex items-center justify-center shadow-sm" 
        aria-label="Chat on WhatsApp"
      >
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- MAIN CONTENT AREA                                                         -->
  <!-- ========================================================================= -->
  <main id="main-content" class="flex-1">

    <!-- ======================================================================= -->
    <!-- HERO SECTION                                                            -->
    <!-- Desktop/Tablet (>=768px): The E-Comet Orbit Graphic                      -->
    <!-- Peeks top ~10-12% of the video section into the bottom of this viewport -->
    <!-- Mobile (<768px): Typography H1 + Supporting Line + 4 Service Rows        -->
    <!-- ======================================================================= -->
    <section id="hero-section" class="relative bg-white bg-dotted-grid overflow-hidden flex flex-col justify-center pt-2 md:h-[calc(100vh-72px-110px)] md:min-h-[580px] md:max-h-[780px]">
      
      <!-- Faint Background Ambient Glows (Blue Top-Left, Orange Bottom-Right) -->
      <div class="pointer-events-none absolute -top-24 -left-24 w-96 h-96 rounded-full bg-blue-500/5 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-24 -right-24 w-96 h-96 rounded-full bg-orange-500/5 blur-3xl" aria-hidden="true"></div>

      <!-- EXACTLY ONE H1 ON THE PAGE -->
      <!-- Desktop: visually hidden with sr-only for SEO/Crawlers/Accessibility -->
      <!-- Mobile: prominently visible -->
      <div class="md:sr-only max-w-xl mx-auto px-6 pt-8 pb-6 text-center">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight leading-tight mb-4">
          Grow Your Business Across Google, <span class="text-brand-blue">Social Media</span> &amp; <span class="text-brand-orange">Marketplaces</span>
        </h1>
        <p class="text-base text-muted leading-relaxed mb-8">
          Digital marketing, e-commerce marketplace management and high-converting websites — all under one growth partner.
        </p>

        <!-- Mobile Stacked Plain-Text Pillar Rows (No cards, no heavy effects) -->
        <div class="space-y-3.5 text-left text-sm max-w-md mx-auto bg-slate-50/80 p-5 rounded-2xl border border-slate-200/80">
          <div class="flex items-start gap-2.5">
            <span class="w-2.5 h-2.5 rounded-full bg-pillar-marketing mt-1.5 flex-shrink-0" aria-hidden="true"></span>
            <div>
              <strong class="text-ink font-semibold">Digital Marketing</strong> — SEO, Google Ads, Meta Ads, Social Media, Leads
            </div>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="w-2.5 h-2.5 rounded-full bg-pillar-marketplaces mt-1.5 flex-shrink-0" aria-hidden="true"></span>
            <div>
              <strong class="text-ink font-semibold">E-commerce &amp; Marketplace</strong> — Amazon, Flipkart, Meesho, Myntra, Nykaa, Quick Commerce
            </div>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="w-2.5 h-2.5 rounded-full bg-pillar-websites mt-1.5 flex-shrink-0" aria-hidden="true"></span>
            <div>
              <strong class="text-ink font-semibold">Website Development</strong> — Shopify, WordPress, WooCommerce, Landing Pages, Redesign
            </div>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="w-2.5 h-2.5 rounded-full bg-pillar-creative mt-1.5 flex-shrink-0" aria-hidden="true"></span>
            <div>
              <strong class="text-ink font-semibold">Creative &amp; Branding</strong> — Branding, Logo, Social Creatives, Reels, Amazon A+ Content
            </div>
          </div>
        </div>
      </div>

      <!-- ===================================================================== -->
      <!-- DESKTOP / TABLET HERO: THE E-COMET ORBIT (Inline SVG + CSS Animation) -->
      <!-- ===================================================================== -->
      <div class="hidden md:flex flex-1 items-center justify-center w-full max-w-[1360px] mx-auto px-4 py-2">
        <svg 
          id="hero-orbit-svg" 
          viewBox="0 0 1200 750" 
          class="w-full h-auto max-h-[720px] select-none" 
          role="img" 
          aria-label="Interactive orbit graphic illustrating E-Comet services across Digital Marketing, Marketplaces, Website Development, and Creative & Branding"
        >
          <title>The E-Comet Growth Orbit</title>
          <desc>An interactive orbital system showing four concentric rings representing Creative &amp; Branding, Website Development, E-commerce Marketplaces, and Digital Marketing surrounding the central astronaut emblem.</desc>

          <defs>
            <!-- Comet Head Radial Gradient (Hot white core to electric blue and fiery orange) -->
            <radialGradient id="cometNucleusGrad" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#FFFFFF" />
              <stop offset="30%" stop-color="#38BDF8" />
              <stop offset="70%" stop-color="#2563EB" />
              <stop offset="100%" stop-color="#F97316" />
            </radialGradient>

            <!-- Comet Tail Linear Gradient -->
            <linearGradient id="cometTailGrad" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#F97316" stop-opacity="0" />
              <stop offset="60%" stop-color="#2563EB" stop-opacity="0.75" />
              <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0.95" />
            </linearGradient>

            <!-- Soft Luminous Filter Glow -->
            <filter id="softGlow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="3.5" result="blur" />
              <feComposite in="SourceGraphic" in2="blur" operator="over" />
            </filter>
          </defs>

