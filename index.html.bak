            title: "Media & Tech",
            items: [
              { label: "Paid Ads Guides", href: "/resources/paid-ads-guides/" },
              { label: "Website Guides", href: "/resources/website-guides/" }
            ]
          },
          {
            title: "Strategy Library",
            items: [
              { label: "Business Guides", href: "/resources/business-guides/" },
              { label: "All Resources", href: "/resources/" }
            ]
          }
        ],
        footerLink: { label: "Browse Resource Library →", href: "/resources/" },
        featured: {
          tag: "INSIGHTS & GUIDES",
          title: "Actionable Strategy Playbooks",
          desc: "In-depth frameworks, tactical checklists, and optimization blueprints from our senior team.",
          cta: "Get Free Growth Audit →",
          href: "/growth-audit/"
        }
      },

      company: {
        id: "company",
        label: "Company",
        pillarColor: "#0B1220",
        columns: [
          {
            title: "About E-Comet",
            items: [
              { label: "About", href: "/about/" },
              { label: "Case Studies", href: "/case-studies/" },
              { label: "Contact", href: "/contact/" }
            ]
          },
          {
            title: "Locations",
            items: [
              { label: "Indore, Madhya Pradesh (HQ)", href: "/locations/indore/" },
              { label: "India & Global Remote", href: "/locations/remote/" },
              { label: "All Locations", href: "/locations/" }
            ]
          }
        ],
        footerLink: { label: "Connect with Leadership →", href: "/contact/" },
        featured: {
          tag: "ONE GROWTH PARTNER",
          title: "Headquartered in Indore, MP",
          desc: "Serving high-growth brands across India and globally. Direct partner involvement on every account.",
          cta: "Get Free Growth Audit →",
          href: "/growth-audit/"
        }
      }
    };

    /**
     * INITIALIZATION ON DOM READY
     */
    document.addEventListener('DOMContentLoaded', () => {
      initHeaderScroll();
      renderDesktopNav();
      renderMobileAccordion();
      initHeaderBackdropBlur();
      initShowreelVideoPlayer();
      initHeroOrbitCycle();
      initScrollThread();
      checkEmblemImage();
    });

    /**
     * HEADER SCROLL STATE
     * Adds subtle bottom border, shadow, and backdrop blur after scrolling
     */
    function initHeaderScroll() {
      const header = document.getElementById('main-header');
      if (!header) return;

      const handleScroll = () => {
        if (window.scrollY > 10) {
          header.classList.add('shadow-sm', 'border-b', 'border-slate-200/80', 'bg-white/95', 'backdrop-blur-md');
          header.classList.remove('bg-white');
        } else {
          header.classList.remove('shadow-sm', 'border-b', 'border-slate-200/80', 'bg-white/95', 'backdrop-blur-md');
          header.classList.add('bg-white');
        }
      };

      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();
    }

    /**
     * HEADER HOVER BACKDROP BLUR
     * Focuses the header and blurs the screen background when interacting with navigation
     */
    function initHeaderBackdropBlur() {
      const header = document.getElementById('main-header');
      const backdrop = document.getElementById('header-backdrop-blur');
      const megamenuContainer = document.getElementById('megamenu-container');
      if (!header || !backdrop) return;

      let blurTimeout = null;

      const showBlur = () => {
        clearTimeout(blurTimeout);
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
        header.classList.add('header-focused');
      };

      const hideBlur = () => {
        blurTimeout = setTimeout(() => {
          if (!currentOpenKey) {
            backdrop.classList.remove('opacity-100', 'pointer-events-auto');
            backdrop.classList.add('opacity-0', 'pointer-events-none');
            header.classList.remove('header-focused');
          }
        }, 140);
      };

      // Header and mega menu mouse listeners
      header.addEventListener('mouseenter', showBlur);
      header.addEventListener('mouseleave', hideBlur);
      if (megamenuContainer) {
        megamenuContainer.addEventListener('mouseenter', showBlur);
        megamenuContainer.addEventListener('mouseleave', hideBlur);
      }

      // Clicking backdrop closes all menus and restores clarity
      backdrop.addEventListener('click', () => {
        closeAllMegaMenus();
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        header.classList.remove('header-focused');
      });
    }

    /**
     * RENDER DESKTOP MEGA NAV & PANELS
     */
    let currentOpenKey = null;
    let navCloseTimeout = null;

    function renderDesktopNav() {
      const navContainer = document.getElementById('desktop-nav');
      const megamenuContainer = document.getElementById('megamenu-container');
      const backdrop = document.getElementById('header-backdrop-blur');
      if (!navContainer || !megamenuContainer) return;

      Object.entries(MENU_DATA).forEach(([key, menu]) => {
        // Nav Trigger Button
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.id = `nav-btn-${key}`;
        btn.className = 'group inline-flex items-center gap-1.5 px-2.5 xl:px-3 py-1.5 rounded-lg text-slate-700 hover:text-ink hover:bg-slate-100/90 transition-all focus-visible:ring-2 focus-visible:ring-brand-blue select-none font-medium text-[13.5px] xl:text-[14px]';
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-haspopup', 'true');
        btn.setAttribute('aria-controls', `megamenu-${key}`);
        btn.innerHTML = `
          <span>${menu.label}</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-ink transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        `;

        // Mega Panel Element
        const panelWrapper = document.createElement('div');
        panelWrapper.id = `megamenu-${key}`;
        panelWrapper.className = 'megamenu-panel hidden opacity-0 -translate-y-2 pointer-events-none transition-all duration-150 pt-3 max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8';
        
        // Build Columns HTML
        const colsHtml = menu.columns.map(col => `
          <div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-3 font-mono">${col.title}</div>
            <ul class="space-y-1">
              ${col.items.map(item => `
                <li>
                  <a href="${item.href}" class="group/link flex items-center gap-2 py-1.5 px-2 -mx-2 rounded-lg text-[13px] text-slate-600 hover:text-ink hover:bg-slate-50 transition-colors">
                    <span class="w-1.5 h-1.5 rounded-full transition-colors" style="background-color: ${menu.pillarColor}40;"></span>
                    <span class="group-hover/link:translate-x-0.5 transition-transform font-medium">${item.label}</span>
                  </a>
                </li>
              `).join('')}
            </ul>
          </div>
        `).join('');

        // Build Featured Card HTML
        const featuredHtml = menu.featured.quote ? `
          <div class="h-full flex flex-col justify-between p-5 rounded-xl bg-slate-50/90 border border-slate-200/80">
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider font-mono text-slate-500">${menu.featured.tag}</span>
              <p class="text-[13px] font-medium text-slate-700 italic leading-relaxed mt-2.5">
                ${menu.featured.quote}
              </p>
            </div>
            <a href="${menu.featured.href}" class="inline-flex items-center text-xs font-bold text-brand-blue hover:text-blue-700 mt-4 group/cta">
              <span>${menu.featured.cta}</span>
            </a>
          </div>
        ` : `
          <div class="h-full flex flex-col justify-between p-5 rounded-xl bg-slate-50/90 border border-slate-200/80">
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider font-mono text-slate-500">${menu.featured.tag}</span>
              <h4 class="text-sm font-bold text-ink mt-2 mb-1.5">${menu.featured.title}</h4>
              <p class="text-xs text-muted leading-relaxed">${menu.featured.desc}</p>
            </div>
            <a href="${menu.featured.href}" class="inline-flex items-center text-xs font-bold text-brand-blue hover:text-blue-700 mt-4 group/cta">
              <span>${menu.featured.cta}</span>
            </a>
          </div>
        `;

        panelWrapper.innerHTML = `
          <div class="bg-white border-x border-b border-slate-200/90 shadow-[0_24px_60px_-15px_rgba(11,18,32,0.18)] rounded-2xl overflow-hidden" style="border-top: 3px solid ${menu.pillarColor};">
            <div class="p-6 grid grid-cols-12 gap-6">
              <div class="col-span-8 md:col-span-9" style="display: grid; grid-template-columns: repeat(${menu.columns.length}, minmax(0, 1fr)); gap: 1.25rem;">
                ${colsHtml}
              </div>
              <div class="col-span-4 md:col-span-3 border-l border-slate-100 pl-6">
                ${featuredHtml}
              </div>
            </div>
            <div class="px-6 py-3 bg-slate-50/90 border-t border-slate-100 flex items-center justify-between text-xs">
              <a href="${menu.footerLink.href}" class="font-bold text-ink hover:text-brand-blue transition-colors flex items-center gap-1">
                ${menu.footerLink.label}
              </a>
              <span class="text-[11px] text-slate-400 font-mono">E-COMET GROWTH ARCHITECTURE</span>
            </div>
          </div>
        `;

        // Mouse & Keyboard Event Handlers
        const openMenu = () => {
          clearTimeout(navCloseTimeout);
          closeAllMegaMenus();
          currentOpenKey = key;
          btn.setAttribute('aria-expanded', 'true');
          btn.classList.add('bg-slate-100', 'text-ink');
          btn.querySelector('svg').classList.add('rotate-180');
          panelWrapper.classList.remove('hidden');

          // Trigger backdrop blur
          if (backdrop) {
            backdrop.classList.remove('opacity-0', 'pointer-events-none');
            backdrop.classList.add('opacity-100', 'pointer-events-auto');
            document.getElementById('main-header').classList.add('header-focused');
          }

          // Trigger smooth slide/fade in
          requestAnimationFrame(() => {
            panelWrapper.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
            panelWrapper.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
          });
        };

        const closeMenu = () => {
          navCloseTimeout = setTimeout(() => {
            btn.setAttribute('aria-expanded', 'false');
            btn.classList.remove('bg-slate-100', 'text-ink');
            btn.querySelector('svg').classList.remove('rotate-180');
            panelWrapper.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
            panelWrapper.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');
            setTimeout(() => {
              if (currentOpenKey === key) {
                panelWrapper.classList.add('hidden');
                currentOpenKey = null;
                // Fade out backdrop blur if mouse not in header
                if (backdrop && !document.getElementById('main-header').matches(':hover')) {
                  backdrop.classList.remove('opacity-100', 'pointer-events-auto');
                  backdrop.classList.add('opacity-0', 'pointer-events-none');
                  document.getElementById('main-header').classList.remove('header-focused');
                }
              }
            }, 150);
          }, 120);
        };

        // Hover events with gap bridge
        btn.addEventListener('mouseenter', openMenu);
        btn.addEventListener('mouseleave', closeMenu);
        panelWrapper.addEventListener('mouseenter', () => clearTimeout(navCloseTimeout));
        panelWrapper.addEventListener('mouseleave', closeMenu);

        // Click toggle
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          if (currentOpenKey === key) {
            closeAllMegaMenus();
          } else {
            openMenu();
          }
        });

        // Keyboard accessibility
        btn.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openMenu();
            const firstLink = panelWrapper.querySelector('a');
            if (firstLink) firstLink.focus();
          }
        });

        navContainer.appendChild(btn);
        megamenuContainer.appendChild(panelWrapper);
      });

      // Global Outside Click & Esc Key Listener
      document.addEventListener('click', (e) => {
        if (!e.target.closest('#desktop-nav') && !e.target.closest('#megamenu-container')) {
          closeAllMegaMenus();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeAllMegaMenus();
        }
      });
    }

    function closeAllMegaMenus() {
      currentOpenKey = null;
      document.querySelectorAll('#desktop-nav button').forEach(btn => {
        btn.setAttribute('aria-expanded', 'false');
        btn.classList.remove('bg-slate-100', 'text-ink');
        const icon = btn.querySelector('svg');
        if (icon) icon.classList.remove('rotate-180');
      });
      document.querySelectorAll('.megamenu-panel').forEach(panel => {
        panel.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
        panel.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');
        setTimeout(() => panel.classList.add('hidden'), 150);
      });
      const backdrop = document.getElementById('header-backdrop-blur');
      if (backdrop && !document.getElementById('main-header').matches(':hover')) {
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        document.getElementById('main-header').classList.remove('header-focused');
      }
    }

    /**
     * RENDER MOBILE ACCORDION DRAWER (<1024px)
     */
    function renderMobileAccordion() {
      const trigger = document.getElementById('mobile-menu-trigger');
      const closeBtn = document.getElementById('mobile-drawer-close');
      const drawer = document.getElementById('mobile-menu-drawer');
      const list = document.getElementById('mobile-accordion-list');
      const bottomBar = document.getElementById('mobile-bottom-bar');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');

      if (!trigger || !drawer || !list) return;

      const toggleDrawer = (open) => {
        if (open) {
          drawer.classList.remove('translate-x-full');
          drawer.setAttribute('aria-hidden', 'false');
          trigger.setAttribute('aria-expanded', 'true');
          document.body.classList.add('overflow-hidden');
          if (bottomBar) bottomBar.classList.add('hidden');
          hamburgerIcon.classList.add('hidden');
          closeIcon.classList.remove('hidden');
        } else {
          drawer.classList.add('translate-x-full');
          drawer.setAttribute('aria-hidden', 'true');
          trigger.setAttribute('aria-expanded', 'false');
          document.body.classList.remove('overflow-hidden');
          if (bottomBar) bottomBar.classList.remove('hidden');
          hamburgerIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        }
      };

      trigger.addEventListener('click', () => {
        const isOpen = !drawer.classList.contains('translate-x-full');
        toggleDrawer(!isOpen);
      });

      if (closeBtn) closeBtn.addEventListener('click', () => toggleDrawer(false));

      // Build Accordion Sections
      Object.entries(MENU_DATA).forEach(([key, menu]) => {
        const sec = document.createElement('div');
        sec.className = 'py-1';

        // Flatten links for clean mobile list
        const allLinks = [];
        menu.columns.forEach(col => {
          col.items.forEach(it => allLinks.push({ ...it, sectionTitle: col.title }));
        });

        sec.innerHTML = `
          <button 
            type="button" 
            class="mobile-accordion-btn w-full min-h-[48px] py-3.5 flex items-center justify-between text-left font-bold text-ink text-base select-none"
            aria-expanded="false"
            data-target="mobile-acc-${key}"
          >
            <span class="flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full" style="background-color: ${menu.pillarColor};"></span>
              <span>${menu.label}</span>
            </span>
            <svg class="w-5 h-5 text-slate-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div id="mobile-acc-${key}" class="hidden pb-4 pt-1 pl-5 space-y-1">
            ${allLinks.map(it => `
              <a href="${it.href}" class="mobile-nav-link block min-h-[44px] py-2.5 text-sm text-slate-600 hover:text-ink active:text-brand-blue flex items-center">
                ${it.label}
              </a>
            `).join('')}
            <a href="${menu.footerLink.href}" class="mobile-nav-link block min-h-[44px] py-3 text-sm font-bold text-brand-blue flex items-center">
              ${menu.footerLink.label}
            </a>
          </div>
        `;

        const btn = sec.querySelector('.mobile-accordion-btn');
        const content = sec.querySelector(`#mobile-acc-${key}`);
        const icon = btn.querySelector('svg');

        btn.addEventListener('click', () => {
          const isCurrentlyOpen = !content.classList.contains('hidden');
          // Close any other open accordion (one open at a time)
          document.querySelectorAll('#mobile-accordion-list > div').forEach(otherSec => {
            const otherContent = otherSec.querySelector('div[id^="mobile-acc-"]');
            const otherIcon = otherSec.querySelector('svg');
            const otherBtn = otherSec.querySelector('button');
            if (otherContent && otherContent !== content) {
              otherContent.classList.add('hidden');
              if (otherIcon) otherIcon.classList.remove('rotate-180');
              if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
            }
          });

          if (isCurrentlyOpen) {
            content.classList.add('hidden');
            icon.classList.remove('rotate-180');
            btn.setAttribute('aria-expanded', 'false');
          } else {
            content.classList.remove('hidden');
            icon.classList.add('rotate-180');
            btn.setAttribute('aria-expanded', 'true');
          }
        });

        list.appendChild(sec);
      });

      // Close drawer on any mobile link click or Esc key
      drawer.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => toggleDrawer(false));
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !drawer.classList.contains('translate-x-full')) {
          toggleDrawer(false);
        }
      });
    }

    /**
     * SHOWREEL VIDEO & FULLSCREEN ZOOM ANIMATION
     * Pure silent video div; expands to full screen with zoom-in transition on click
     */
    function initShowreelVideoPlayer() {
      const card = document.getElementById('showreel-card');
      const mainVideo = document.getElementById('showreel-video');
      const modal = document.getElementById('video-fullscreen-modal');
      const modalVideo = document.getElementById('modal-fullscreen-video');
      const closeBtn = document.getElementById('close-fullscreen-modal-btn');
      if (!card || !mainVideo || !modal || !modalVideo) return;

      const openFullscreen = () => {
        modalVideo.currentTime = mainVideo.currentTime;
        modal.classList.add('is-active');
        modalVideo.play().catch(() => {});
        document.body.classList.add('overflow-hidden');
      };

      const closeFullscreen = () => {
        mainVideo.currentTime = modalVideo.currentTime;
        modal.classList.remove('is-active');
        document.body.classList.remove('overflow-hidden');
      };

      card.addEventListener('click', openFullscreen);
      if (closeBtn) closeBtn.addEventListener('click', closeFullscreen);

      modal.addEventListener('click', (e) => {
        // If clicking outside the video or on close button
        if (e.target === modal || e.target.closest('#close-fullscreen-modal-btn')) {
          closeFullscreen();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('is-active')) {
          closeFullscreen();
        }
      });
    }

    /**
     * HERO ORBIT ACTIVATION CYCLE
     * Cycle every ~3s through all four pillars: Creative -> Websites -> Marketplaces -> Marketing
     * Hover/focus on any ring label pauses cycle and highlights that pillar
     */
    function initHeroOrbitCycle() {
      // Do not run animations on mobile (<768px)
      if (window.innerWidth < 768) return;

      const PILLARS = ['creative', 'websites', 'marketplaces', 'marketing'];
      let currentIdx = 0;
      let cycleTimer = null;
      let isPaused = false;

      const setActivePillar = (pillarName) => {
        PILLARS.forEach(p => {
          const group = document.getElementById(`pillar-group-${p}`);
          if (!group) return;
          if (p === pillarName) {
            group.classList.add('is-active');
            group.classList.remove('is-dimmed');
          } else {
            group.classList.remove('is-active');
            group.classList.add('is-dimmed');
          }
        });
      };

      const nextPillar = () => {
        if (isPaused) return;
        currentIdx = (currentIdx + 1) % PILLARS.length;
        setActivePillar(PILLARS[currentIdx]);
      };

      // Set initial active state
      setActivePillar(PILLARS[currentIdx]);

      // Respect prefers-reduced-motion
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReduced) {
        // Show all pillars statically without dimming
        PILLARS.forEach(p => {
          const group = document.getElementById(`pillar-group-${p}`);
          if (group) {
            group.classList.remove('is-dimmed');
            group.classList.add('is-active');
          }
        });
        const svg = document.getElementById('hero-orbit-svg');
        if (svg && svg.pauseAnimations) svg.pauseAnimations();
        return;
      }

      // Start 3s cycle
      cycleTimer = setInterval(nextPillar, 3000);

      // Label Badge Hover & Focus Handlers
      document.querySelectorAll('.pillar-label-badge').forEach(badge => {
        const pillar = badge.getAttribute('data-pillar-trigger');

        const handleEnter = () => {
          isPaused = true;
          setActivePillar(pillar);
          currentIdx = PILLARS.indexOf(pillar);
        };

        const handleLeave = () => {
          isPaused = false;
        };

        badge.addEventListener('mouseenter', handleEnter);
        badge.addEventListener('mouseleave', handleLeave);
        badge.addEventListener('focusin', handleEnter);
        badge.addEventListener('focusout', handleLeave);
      });
    }

    /**
     * SCROLL-THREAD SVG ANIMATION
     * Dynamically draws down the page as user scrolls
     */
    function initScrollThread() {
      const threadPath = document.getElementById('scroll-thread-path');
      if (!threadPath) return;

      const pathLength = threadPath.getTotalLength ? threadPath.getTotalLength() : 2500;
      threadPath.style.strokeDasharray = pathLength;
      
      // Respect prefers-reduced-motion
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        threadPath.style.strokeDashoffset = 0;
        return;
      }

      threadPath.style.strokeDashoffset = pathLength;

      let ticking = false;

      const updateScrollThread = () => {
        const scrollY = window.scrollY || window.pageYOffset;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        if (maxScroll <= 0) return;

        // Progress between 0 and 1
        const progress = Math.min(Math.max(scrollY / (maxScroll * 0.85), 0), 1);
        const drawOffset = pathLength - (progress * pathLength);
        threadPath.style.strokeDashoffset = drawOffset;

        ticking = false;
      };

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(updateScrollThread);
          ticking = true;
        }
      }, { passive: true });

      updateScrollThread();
    }

    /**
     * CHECK FOR CUSTOM EMBLEM.PNG
     * If assets/emblem.png exists in workspace, automatically swap
     */
    function checkEmblemImage() {
      const testImg = new Image();
      testImg.onload = function() {
        const placeholder = document.getElementById('placeholder-emblem-svg');
        const container = document.getElementById('hero-emblem-container');
        if (placeholder && container) {
          placeholder.style.display = 'none';
          const imgElem = document.createElementNS('http://www.w3.org/2000/svg', 'image');
          imgElem.setAttribute('href', 'assets/emblem.png');
          imgElem.setAttribute('x', '525');
          imgElem.setAttribute('y', '275');
          imgElem.setAttribute('width', '150');
          imgElem.setAttribute('height', '150');
          imgElem.setAttribute('preserveAspectRatio', 'xMidYMid meet');
          container.appendChild(imgElem);
        }
      };
      testImg.src = 'assets/emblem.png';
    }
  </script>
</body>
</html>
